{
  "name": "colauloanthe-protocol-notes",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "npm run typecheck && node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "start": "node --experimental-strip-types src/cli/connect.ts",
    "connect": "node --experimental-strip-types src/cli/connect.ts",
    "login": "node --experimental-strip-types src/cli/connect.ts --login",
    "world": "node --experimental-strip-types src/cli/connect.ts --world",
    "quest": "node --experimental-strip-types src/cli/quest-run.ts",
    "scan": "node --experimental-strip-types src/cli/map-scan-run.ts",
    "items": "node --experimental-strip-types src/cli/items-run.ts",
    "bag": "node --experimental-strip-types src/cli/bag-run.ts",
    "skills": "node --experimental-strip-types src/cli/skills-run.ts",
    "zone": "node --experimental-strip-types src/cli/zone-run.ts",
    "buy": "node --experimental-strip-types src/cli/buy-run.ts",
    "smith": "node --experimental-strip-types src/cli/smith-run.ts",
    "gift": "node --experimental-strip-types src/cli/gift-run.ts",
    "mail": "node --experimental-strip-types src/cli/mail-run.ts",
    "daily": "node --experimental-strip-types src/cli/daily-run.ts",
    "battles": "node --experimental-strip-types --no-warnings src/cli/battles.ts",
    "test:scenario": "node --experimental-strip-types test/scenario-runner.ts",
    "check:apk": "node --experimental-strip-types src/cli/check-apk.ts",
    "check:capture": "node --experimental-strip-types src/cli/check-capture.ts",
    "export:rust": "node --experimental-strip-types src/cli/export-rust.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3"
  }
}
