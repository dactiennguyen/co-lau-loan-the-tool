{
  // Type-check of the Worker (src/) and its tests (test/): `yarn typecheck`, also run by `yarn test`. Wrangler bundles
  // src/ for Cloudflare; the tests run on Node through tsx, which also turns the JSX of src/views/*.tsx (hono/jsx) into
  // calls.
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types", "node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
