{
  "name": "cllt-server",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker + D1 that keeps the accounts of CLLT Tool, with an admin page (README.md)",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:client": "node scripts/build-client.mjs",
    "icons": "node scripts/icons.mjs",
    "db:migrate:local": "wrangler d1 migrations apply cllt --local",
    "db:migrate": "wrangler d1 migrations apply cllt --remote",
    "d1:id": "node scripts/d1-id.mjs",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p client",
    "test": "yarn typecheck && node --import tsx --no-warnings --test test/*.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261101.1",
    "@material-symbols/svg-400": "^0.48.2",
    "@material/web": "^2.5.0",
    "@types/node": "22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "wrangler": "4.156.1"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.15",
    "zod": "^4.6.7"
  }
}
